{
  "info": {
    "name": "AsistQR",
    "description": "API REST de AsistQR. Ajusta las variables `baseUrl` y `pin` de la colección antes de empezar.\n\nFlujo sugerido: Verificar PIN → Crear evento → Obtener QR → Registrar asistencia → Asistentes del evento.\n\nLa carpeta \"Archivos de la PWA\" comprueba que el servidor entrega el manifest, el splash y la app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "pin", "value": "1234" },
    { "key": "eventoId", "value": "1" },
    { "key": "token", "value": "" },
    { "key": "asistenciaId", "value": "" },
    { "key": "matricula", "value": "UTP0123456" }
  ],
  "item": [
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/salud"
      }
    },
    {
      "name": "PIN de organizador",
      "item": [
        {
          "name": "Verificar PIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content: el PIN es correcto', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-PIN", "value": "{{pin}}" }],
            "url": "{{baseUrl}}/api/pin"
          }
        },
        {
          "name": "Verificar PIN incorrecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('error pin_invalido', () => pm.expect(pm.response.json().error).to.eql('pin_invalido'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-PIN", "value": "0000" }],
            "url": "{{baseUrl}}/api/pin"
          }
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos"
          }
        },
        {
          "name": "Detalle de evento",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}"
          }
        },
        {
          "name": "Crear evento",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Evento activo: empezó hace 10 min y termina en 2 h.",
                  "const ahora = Date.now();",
                  "pm.variables.set('inicio', new Date(ahora - 10 * 60 * 1000).toISOString());",
                  "pm.variables.set('fin', new Date(ahora + 2 * 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('eventoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-PIN", "value": "{{pin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tutoría Grupal 5A\",\n  \"descripcion\": \"Sesión de tutoría\",\n  \"lugar\": \"Edificio de TI, aula 5A\",\n  \"inicio\": \"{{inicio}}\",\n  \"fin\": \"{{fin}}\",\n  \"latitud\": 19.0414,\n  \"longitud\": -98.2063,\n  \"radio_m\": 150\n}"
            },
            "url": "{{baseUrl}}/api/eventos"
          }
        },
        {
          "name": "Modificar evento",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-PIN", "value": "{{pin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tutoría Grupal 5A (editado)\",\n  \"descripcion\": \"\",\n  \"lugar\": \"Aula 5B\",\n  \"inicio\": \"2026-11-28T16:00:00Z\",\n  \"fin\": \"2026-11-28T18:00:00Z\",\n  \"latitud\": 19.0414,\n  \"longitud\": -98.2063,\n  \"radio_m\": 100\n}"
            },
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}"
          }
        },
        {
          "name": "Obtener QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-PIN", "value": "{{pin}}" }],
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}/qr"
          }
        },
        {
          "name": "Asistentes del evento",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-PIN", "value": "{{pin}}" }],
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}/asistencias"
          }
        },
        {
          "name": "Eliminar evento",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-PIN", "value": "{{pin}}" }],
            "url": "{{baseUrl}}/api/eventos/{{eventoId}}"
          }
        }
      ]
    },
    {
      "name": "Asistencias",
      "item": [
        {
          "name": "Registrar asistencia",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// uuid nuevo y hora actual en cada envío.",
                  "pm.variables.set('uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.variables.set('capturadaEn', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('asistenciaId', pm.response.json().asistencia.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{uuid}}\",\n  \"token\": \"{{token}}\",\n  \"matricula\": \"{{matricula}}\",\n  \"nombre\": \"Ana López\",\n  \"capturadaEn\": \"{{capturadaEn}}\",\n  \"latitud\": 19.0415,\n  \"longitud\": -98.2062,\n  \"precision\": 12,\n  \"offline\": false\n}"
            },
            "url": "{{baseUrl}}/api/asistencias"
          }
        },
        {
          "name": "Registrar asistencia sin ubicación",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('uuid', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.variables.set('capturadaEn', new Date().toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{uuid}}\",\n  \"token\": \"{{token}}\",\n  \"matricula\": \"UTP0999999\",\n  \"nombre\": \"Luis Pérez\",\n  \"capturadaEn\": \"{{capturadaEn}}\",\n  \"offline\": true\n}"
            },
            "url": "{{baseUrl}}/api/asistencias"
          }
        },
        {
          "name": "Historial de alumno",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/asistencias?matricula={{matricula}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "asistencias"],
              "query": [{ "key": "matricula", "value": "{{matricula}}" }]
            }
          }
        },
        {
          "name": "Eliminar asistencia",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-PIN", "value": "{{pin}}" }],
            "url": "{{baseUrl}}/api/asistencias/{{asistenciaId}}"
          }
        }
      ]
    },
    {
      "name": "Vistas del servidor",
      "item": [
        {
          "name": "Formulario de PIN",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/eventos/{{eventoId}}/lista"
          }
        },
        {
          "name": "Lista de asistencia (HTML)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "pin", "value": "{{pin}}" }]
            },
            "url": "{{baseUrl}}/eventos/{{eventoId}}/lista"
          }
        }
      ]
    },
    {
      "name": "Archivos de la PWA",
      "item": [
        {
          "name": "Manifest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const manifest = pm.response.json();",
                  "pm.test('start_url apunta al splash', () => pm.expect(manifest.start_url).to.eql('/splash.html'));",
                  "pm.test('íconos de 192 y 512', () => {",
                  "  const tamanos = manifest.icons.map((icono) => icono.sizes);",
                  "  pm.expect(tamanos).to.include('192x192');",
                  "  pm.expect(tamanos).to.include('512x512');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/manifest.json"
          }
        },
        {
          "name": "Splash",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK en HTML', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "pm.test('enlaza el manifest', () => pm.expect(pm.response.text()).to.include('rel=\"manifest\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/splash.html"
          }
        },
        {
          "name": "App (index.html)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK en HTML', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});",
                  "pm.test('carga el módulo de la app', () => pm.expect(pm.response.text()).to.include('/js/app.js'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Ícono 512",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK como PNG', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/png');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/img/icono-512.png"
          }
        }
      ]
    }
  ]
}
