<%# Formulario para pedir el PIN del organizador. Recibe: evento, error (texto o null). %>
<%- include('parciales/encabezado', { titulo: 'Lista de asistencia' }) %>
<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center p-6">
  <div class="rounded-2xl bg-white p-6 shadow-sm">
    <p class="text-sm font-semibold tracking-wide text-marca uppercase">Lista de asistencia</p>
    <h1 class="mt-1 text-xl font-bold"><%= evento.nombre %></h1>
    <p class="mt-2 text-sm text-slate-600">Ingresa el PIN de organizador para ver la lista.</p>

    <form method="post" class="mt-5 space-y-4">
      <label class="block">
        <span class="text-sm font-medium">PIN</span>
        <input type="password" name="pin" inputmode="numeric" autocomplete="off" required autofocus
               class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-lg tracking-widest focus:border-marca focus:ring-2 focus:ring-marca/30 focus:outline-none">
      </label>

      <% if (error) { %>
        <p class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"><%= error %></p>
      <% } %>

      <button type="submit"
              class="w-full rounded-lg bg-marca px-4 py-3 font-semibold text-white hover:bg-marca/90">
        Ver lista
      </button>
    </form>
  </div>
</main>
<%- include('parciales/pie') %>
