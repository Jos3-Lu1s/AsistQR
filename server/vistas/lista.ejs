<%# Lista de asistencia de un evento. Recibe: evento, horario, generadaEn, resumen, asistencias. %>
<%
  // Etiqueta y colores de cada estado (verde = válida, rojo = error, ámbar = aviso).
  const ESTADOS = {
    valida: { texto: 'Válida', clases: 'bg-green-100 text-green-800' },
    fuera_de_rango: { texto: 'Fuera de rango', clases: 'bg-red-100 text-red-800' },
    fuera_de_horario: { texto: 'Fuera de horario', clases: 'bg-red-100 text-red-800' },
    sin_ubicacion: { texto: 'Sin ubicación', clases: 'bg-amber-100 text-amber-800' },
  };

  // Tarjetas de totales, en el orden en que se muestran.
  const TOTALES = [
    { clave: 'total', texto: 'Total', clases: 'text-slate-900' },
    { clave: 'valida', texto: 'Válidas', clases: 'text-green-700' },
    { clave: 'fuera_de_rango', texto: 'Fuera de rango', clases: 'text-red-700' },
    { clave: 'fuera_de_horario', texto: 'Fuera de horario', clases: 'text-red-700' },
    { clave: 'sin_ubicacion', texto: 'Sin ubicación', clases: 'text-amber-700' },
    { clave: 'offline', texto: 'Offline', clases: 'text-marca' },
  ];
%>
<%- include('parciales/encabezado', { titulo: `Lista · ${evento.nombre}` }) %>
<main class="mx-auto max-w-5xl space-y-6 p-4 sm:p-8 print:max-w-none print:space-y-4 print:p-0">
  <header class="rounded-2xl bg-white p-6 shadow-sm print:rounded-none print:p-0 print:shadow-none">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-semibold tracking-wide text-marca uppercase">Lista de asistencia</p>
        <h1 class="mt-1 text-2xl font-bold"><%= evento.nombre %></h1>
        <% if (evento.descripcion) { %>
          <p class="mt-1 text-slate-600"><%= evento.descripcion %></p>
        <% } %>
      </div>
      <button type="button" onclick="window.print()"
              class="shrink-0 rounded-lg bg-marca px-4 py-2 font-semibold text-white hover:bg-marca/90 print:hidden">
        Imprimir
      </button>
    </div>

    <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
      <div>
        <dt class="text-slate-500">Lugar</dt>
        <dd class="font-medium"><%= evento.lugar || '—' %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Horario</dt>
        <dd class="font-medium"><%= horario %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Radio permitido</dt>
        <dd class="font-medium"><%= evento.radio_m %> m</dd>
      </div>
    </dl>

    <p class="mt-4 text-xs text-slate-500">Generada el <%= generadaEn %></p>
  </header>

  <section aria-label="Totales" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 print:grid-cols-6 print:gap-2">
    <% for (const t of TOTALES) { %>
      <div class="rounded-xl bg-white p-4 shadow-sm print:border print:border-slate-300 print:p-2 print:shadow-none">
        <p class="text-xs text-slate-500"><%= t.texto %></p>
        <p class="text-2xl font-bold <%= t.clases %>" data-resumen="<%= t.clave %>"><%= resumen[t.clave] %></p>
      </div>
    <% } %>
  </section>

  <section aria-label="Asistentes" class="overflow-hidden rounded-2xl bg-white shadow-sm print:rounded-none print:shadow-none">
    <% if (asistencias.length === 0) { %>
      <p class="p-8 text-center text-slate-500">Sin asistentes registrados</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm print:text-xs">
          <thead class="bg-slate-50 text-xs text-slate-500 uppercase print:bg-white">
            <tr>
              <th class="px-4 py-3 print:px-2 print:py-1">Matrícula</th>
              <th class="px-4 py-3 print:px-2 print:py-1">Nombre</th>
              <th class="px-4 py-3 print:px-2 print:py-1">Escaneo</th>
              <th class="px-4 py-3 print:px-2 print:py-1">Recepción</th>
              <th class="px-4 py-3 print:px-2 print:py-1">Estado</th>
              <th class="px-4 py-3 text-right print:px-2 print:py-1">Distancia</th>
              <th class="px-4 py-3 text-right print:px-2 print:py-1">Precisión</th>
              <th class="px-4 py-3 print:px-2 print:py-1">Offline</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 print:divide-slate-300">
            <% for (const a of asistencias) { %>
              <tr>
                <td class="px-4 py-2 font-mono print:px-2 print:py-1"><%= a.matricula %></td>
                <td class="px-4 py-2 font-medium print:px-2 print:py-1"><%= a.nombre %></td>
                <td class="px-4 py-2 tabular-nums print:px-2 print:py-1"><%= a.capturada %></td>
                <td class="px-4 py-2 tabular-nums print:px-2 print:py-1"><%= a.recibida %></td>
                <td class="px-4 py-2 print:px-2 print:py-1">
                  <span class="rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap <%= ESTADOS[a.estado].clases %>"><%= ESTADOS[a.estado].texto %></span>
                </td>
                <td class="px-4 py-2 text-right tabular-nums print:px-2 print:py-1"><%= a.distancia %></td>
                <td class="px-4 py-2 text-right tabular-nums print:px-2 print:py-1"><%= a.precision %></td>
                <td class="px-4 py-2 print:px-2 print:py-1">
                  <% if (a.offline) { %>
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-marca" data-offline>Offline</span>
                  <% } else { %>
                    <span class="text-slate-400">—</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>
<%- include('parciales/pie') %>
