# Copia este archivo como .env y ajusta los valores.

# Puerto HTTP del servidor
PORT=3000

# Ruta del archivo SQLite
DB_PATH=server/data/asistqr.db

# PIN del organizador (header X-PIN). ¡Cámbialo antes de usarlo en serio!
ORGANIZADOR_PIN=1234

